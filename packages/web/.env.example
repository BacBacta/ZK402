# Copier en packages/web/.env.local

# Adresse de ConfidentialPaywall (sortie de `pnpm base-sepolia:deploy`)
NEXT_PUBLIC_PAYWALL_ADDRESS=

# RPC Base Sepolia (navigateur + serveur)
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Serveur uniquement (jamais préfixé NEXT_PUBLIC_) ---
# Clé du facilitateur : son adresse doit être celle passée à deploy-paywall
# (--facilitator ou FACILITATOR_ADDRESS). Elle ne sert qu'à signer un ACP
# (EIP-712, hors chaîne) pour déchiffrer l'accès des payeurs : aucun fonds requis.
FACILITATOR_PRIVATE_KEY=

# Secret HMAC des nonces x402 (ex. `openssl rand -hex 32`)
X402_NONCE_SECRET=
