# Copier en .env à la racine (lu par packages/contracts). TESTNET UNIQUEMENT.

# Clé du déployeur (Base Sepolia). Ne jamais y mettre une clé détenant des fonds réels.
PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# Adresse du serveur x402 (facilitateur) autorisé à déchiffrer l'accès des payeurs.
# Défaut : l'adresse du déployeur.
FACILITATOR_ADDRESS=
